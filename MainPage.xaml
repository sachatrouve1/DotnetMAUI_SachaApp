<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SachaApp.MainPage">
    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout
                Padding="30,0"
                Spacing="25">
                
                <Label
                    Text="BeerGrills"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    FontSize="32" />
                
                <Label
                    Text="Welcome to the BeerGrills app!"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    FontSize="20" />

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">
                    <Image
                        Grid.Column="0"
                        Source="beers1.png"
                        HeightRequest="185"
                        Aspect="AspectFit"
                        SemanticProperties.Description="beer" />

                    <Image
                        Grid.Column="1"
                        Source="beers2.png"
                        HeightRequest="185"
                        Aspect="AspectFit"
                        SemanticProperties.Description="beer" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>