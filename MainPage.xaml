<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SachaApp.Page1">
    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout
                Padding="30,0"
                Spacing="25">

                <Label
                    Text="Ale"
                    Style="{StaticResource Headline}"
                    SemanticProperties.HeadingLevel="Level1" />
                
                <Image
                    Source="alepng"
                    HeightRequest="185"
                    Aspect="AspectFit"
                    SemanticProperties.Description="ale beer" />
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>