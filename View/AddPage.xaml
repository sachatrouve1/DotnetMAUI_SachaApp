<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SachaApp.View.AddPage">
    <ContentPage.Content>
        <Grid>
            <ScrollView>
                <VerticalStackLayout
                    Padding="30,0"
                    Spacing="25">
                    <Label
                        Text="Add your own beer!"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        FontSize="32" />

                    <Entry
                        x:Name="TitleEntry"
                        Placeholder="Beer's title"
                        ClearButtonVisibility="WhileEditing" />

                    <Editor
                        x:Name="DescriptionEditor"
                        Placeholder="Description"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="120" />

                    <Entry
                        x:Name="ImageEntry"
                        Placeholder="Image (URL or local file)"
                        TextChanged="OnImageEntryTextChanged"
                        ClearButtonVisibility="WhileEditing" />

                    <Image
                        x:Name="PreviewImage"
                        HeightRequest="150"
                        Aspect="AspectFit"
                        IsVisible="False" />

                    <Button
                        Text="Add to the shop"
                        Clicked="OnAddBeerClicked" />
                </VerticalStackLayout>
            </ScrollView>

            <AbsoluteLayout x:Name="BubbleLayer"
                            InputTransparent="True"
                            Margin="16">
                <Border x:Name="Bubble1" WidthRequest="14" HeightRequest="14" BackgroundColor="#66FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 999" />
                <Border x:Name="Bubble2" WidthRequest="10" HeightRequest="10" BackgroundColor="#55FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 999" />
                <Border x:Name="Bubble3" WidthRequest="18" HeightRequest="18" BackgroundColor="#55FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 999" />
                <Border x:Name="Bubble4" WidthRequest="12" HeightRequest="12" BackgroundColor="#66FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 999" />
                <Border x:Name="Bubble5" WidthRequest="9" HeightRequest="9" BackgroundColor="#55FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 999" />
                <Border x:Name="Bubble6" WidthRequest="16" HeightRequest="16" BackgroundColor="#66FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 999" />
            </AbsoluteLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>