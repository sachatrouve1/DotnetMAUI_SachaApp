<?xml version="1.0" encoding="UTF-8"?>

<Shell
    x:Class="SachaApp.View.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SachaApp.View">

    <TabBar>
        <Tab Title="Home" Icon="home.svg">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
        </Tab>
        <Tab Title="Shop" Icon="search.svg">
            <ShellContent ContentTemplate="{DataTemplate local:ShopPage}" Route="ShopPage" />
        </Tab>
        <Tab Title="Your beer" Icon="favorite.svg">
            <ShellContent ContentTemplate="{DataTemplate local:AddPage}" Route="AddPage" />
        </Tab>
        <Tab Title="Lab" Icon="settings.svg">
            <ShellContent ContentTemplate="{DataTemplate local:LabPage}" Route="LabPage" />
        </Tab>
    </TabBar>

</Shell>