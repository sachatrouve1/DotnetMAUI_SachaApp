<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SachaApp.View.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SachaApp.View">
    
    <TabBar>
        <Tab Title="Home" Icon="home.svg">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
        </Tab>
        <Tab Title="Lager" Icon="search.svg">
            <ShellContent ContentTemplate="{DataTemplate local:Page2}" Route="Page2" />
        </Tab>
        <Tab Title="Stout" Icon="favorite.svg">
            <ShellContent ContentTemplate="{DataTemplate local:Page3}" Route="Page3" />
        </Tab>
        <Tab Title="Pilsner" Icon="settings.svg">
            <ShellContent ContentTemplate="{DataTemplate local:Page4}" Route="Page4" />
        </Tab>
    </TabBar>

</Shell>
